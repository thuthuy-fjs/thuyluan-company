# Optional: set only when the Worker has a real configured quotation recipient.
# NEXT_PUBLIC_QUOTE_ENDPOINT=/api/quote
# NEXT_PUBLIC_SITE_URL=https://suatancongnghiepthuyluan.com
# Configure server-side secrets using Wrangler, never NEXT_PUBLIC_* variables:
# npx wrangler secret put QUOTE_WEBHOOK_URL
# npx wrangler secret put QUOTE_WEBHOOK_TOKEN

# Admin is enabled after these secrets are set in Cloudflare:
# ADMIN_PIN: random 10-16 digit numeric code
# ADMIN_SESSION_SECRET: random secret with at least 32 bytes of entropy
# GITHUB_TOKEN: fine-grained GitHub token with Contents write for this repository
# GITHUB_DRAFT_BRANCH: optional; defaults to GITHUB_BRANCH + "-draft"
