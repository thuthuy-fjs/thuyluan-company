{
  "name": "thuy-luan-homepage",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build && node scripts/postbuild.mjs",
    "start": "wrangler dev",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test tests/worker.test.mjs tests/gallery-order.test.mjs",
    "test:browser": "playwright test",
    "build:worker": "npm run build && wrangler deploy --dry-run --outdir /tmp/thuyluan-worker-build",
    "preview:static": "node scripts/preview.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.5.23",
    "wrangler": "^4.151.0"
  },
  "type": "module",
  "overrides": {
    "postcss": "$postcss"
  }
}
